<template id="plantilla-tarea">
    <li class="gt-tarea">

        <div class="gt-vista js-vista">
            <input type="checkbox" class="gt-check js-estado" aria-label="Marcar como completada" />

            <div class="gt-contenido">
                <h3 class="gt-titulo js-titulo"></h3>
                <p class="gt-descripcion js-descripcion"></p>
                <div class="gt-meta">
                    <span class="gt-insignia js-estado-texto"></span>
                    <span class="gt-fecha">
                        <svg class="gt-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                        Creada <span class="js-fecha"></span>
                    </span>
                </div>
            </div>

            <div class="gt-acciones js-acciones">
                <button type="button" class="gt-btn-icono js-editar" aria-label="Editar tarea" title="Editar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                </button>
                <button type="button" class="gt-btn-icono gt-btn-icono-peligro js-eliminar" aria-label="Eliminar tarea" title="Eliminar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v5M14 11v5" /></svg>
                </button>
            </div>

            <div class="gt-confirmacion js-confirmacion" role="group" aria-label="Confirmar eliminacion" hidden>
                <span>Eliminar?</span>
                <button type="button" class="gt-btn gt-btn-chico gt-btn-peligro js-confirmar-si">Si, eliminar</button>
                <button type="button" class="gt-btn gt-btn-chico js-confirmar-no">No</button>
            </div>
        </div>

        <form class="gt-edicion js-form-editar" novalidate hidden>
            <div class="gt-campo">
                <div class="gt-campo-cabecera">
                    <span class="gt-etiqueta" aria-hidden="true">Titulo</span>
                    <span class="gt-conteo js-conteo" aria-hidden="true"></span>
                </div>
                <input type="text" class="js-edit-titulo" maxlength="100" required aria-label="Titulo" />
            </div>
            <div class="gt-campo">
                <div class="gt-campo-cabecera">
                    <span class="gt-etiqueta" aria-hidden="true">Descripcion</span>
                    <span class="gt-conteo js-conteo" aria-hidden="true"></span>
                </div>
                <textarea class="js-edit-descripcion" maxlength="500" rows="3" required aria-label="Descripcion"></textarea>
            </div>
            <div class="gt-edicion-acciones">
                <button type="button" class="gt-btn js-cancelar">Cancelar</button>
                <button type="submit" class="gt-btn gt-btn-primario">Guardar cambios</button>
            </div>
        </form>

    </li>
</template>
