<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewBag.Title - Gestor de Tareas</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
    @RenderSection("estilos", required: false)
</head>
<body>
    <header class="sitio-encabezado">
        <div class="sitio-contenedor sitio-encabezado-interior">
            <a class="sitio-marca" href="@Url.Action("Index", "Tareas")">
                <span class="sitio-logo" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                </span>
                Gestor de Tareas
            </a>
        </div>
    </header>

    <main class="sitio-contenedor sitio-principal">
        @RenderBody()
    </main>

    <footer class="sitio-pie">

    </footer>

    <script src="@Url.Content("~/Scripts/jquery-3.7.1.min.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
